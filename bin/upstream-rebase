#!/usr/bin/env bash
# Rebase the current delivery branch onto we-promise/sure main, then lint the
# files it changes and run the tests you name.
#
#   bin/upstream-rebase                       # rebase, lint changed files
#   bin/upstream-rebase test/models/loan      # ... and run these tests
#   bin/upstream-rebase --onto up/parent ...  # a stacked branch: drop the
#                                             # parent's commits once its
#                                             # upstream PR has merged
#   bin/upstream-rebase --no-lint ...
#
# See docs/llm-guides/upstream-delivery.md.
set -euo pipefail

onto=""
lint=1
tests=()
while [ $# -gt 0 ]; do
  case "$1" in
    --onto) onto="$2"; shift 2 ;;
    --no-lint) lint=0; shift ;;
    -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
    *) tests+=("$1"); shift ;;
  esac
done

branch="$(git rev-parse --abbrev-ref HEAD)"
case "$branch" in
  up/*) ;;
  *) echo "upstream-rebase: '$branch' is not a delivery branch (up/*); refusing to rebase it." >&2; exit 2 ;;
esac

if [ -n "$(git status --porcelain)" ]; then
  echo "upstream-rebase: the working tree is not clean; commit or stash first." >&2
  exit 2
fi

git remote get-url upstream >/dev/null 2>&1 || git remote add upstream https://github.com/we-promise/sure.git
git fetch --no-tags upstream main

before="$(git rev-parse --short HEAD)"
if [ -n "$onto" ]; then
  echo "Rebasing $branch onto upstream/main, dropping the commits it shares with $onto"
  git rebase --onto upstream/main "$onto" || {
    echo; echo "upstream-rebase: conflicts. Resolve them, 'git rebase --continue', then run this again with the same arguments." >&2; exit 1; }
else
  echo "Rebasing $branch onto upstream/main"
  git rebase upstream/main || {
    echo; echo "upstream-rebase: conflicts. Resolve them, 'git rebase --continue', then run this again with the same arguments." >&2; exit 1; }
fi
echo "$branch: $before -> $(git rev-parse --short HEAD), $(git rev-list --count upstream/main..HEAD) commit(s) on upstream/main $(git rev-parse --short upstream/main)"

if [ "$lint" -eq 1 ]; then
  changed() { git diff --name-only upstream/main...HEAD --diff-filter=AMR | grep -E "$1" || true; }
  rb="$(changed '\.rb$')"; erb="$(changed '\.erb$')"; js="$(changed '\.js$')"
  [ -n "$rb" ] && { echo "rubocop"; echo "$rb" | xargs bin/rubocop; }
  [ -n "$erb" ] && { echo "erb_lint"; echo "$erb" | xargs bundle exec erb_lint; }
  [ -n "$js" ] && { echo "biome"; echo "$js" | xargs npx biome lint; }
fi

if [ ${#tests[@]} -gt 0 ]; then
  echo "bin/rails test ${tests[*]}"
  bin/rails test "${tests[@]}"
else
  echo "No tests named; run the suites the change touches before pushing."
fi
