<%# locals: (effective_date:, rate:, disabled: false) %>

<%# `disabled` is set server-side for a fixed loan so the row is not submitted
    even without JavaScript; the Stimulus controller toggles it from there. %>
<div class="flex items-center gap-2" data-rate-change-row>
  <%# The same field shape StyledFormBuilder renders (.form-field, a label, the
      input), written out because the builder labels through `for`/id. This
      partial is also the JS clone template, so an id would repeat on every
      cloned row; each label wraps its input instead, which associates the two
      without one. %>
  <div class="form-field">
    <label class="form-field__body">
      <span class="form-field__label"><%= t("loans.form.rate_change_effective_date") %></span>
      <input type="date"
             name="account[accountable_attributes][rate_changes][][effective_date]"
             value="<%= effective_date %>"
             autocomplete="off"
             class="form-field__input"
             <%= "disabled" if disabled %>>
    </label>
  </div>

  <div class="form-field">
    <label class="form-field__body">
      <span class="form-field__label"><%= t("loans.form.rate_change_rate") %></span>
      <input type="number" step="0.005" min="0" max="100"
             name="account[accountable_attributes][rate_changes][][rate]"
             value="<%= rate %>"
             autocomplete="off"
             class="form-field__input"
             <%= "disabled" if disabled %>>
    </label>
  </div>

  <%= render DS::Button.new(text: t("loans.form.rate_change_remove"), variant: "ghost", type: "button", class: "shrink-0",
                            disabled: disabled, data: { action: "loan-rate-changes#remove" }) %>
</div>
