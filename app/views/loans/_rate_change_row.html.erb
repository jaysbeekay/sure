<%# locals: (effective_date:, rate:) %>

<div class="flex items-end gap-2" data-rate-change-row>
  <label class="sr-only" for="rate_change_effective_date"><%= t("loans.form.rate_change_effective_date") %></label>
  <input type="date"
         name="account[accountable_attributes][rate_changes][][effective_date]"
         value="<%= effective_date %>"
         autocomplete="off"
         aria-label="<%= t("loans.form.rate_change_effective_date") %>"
         class="form-field__input">

  <label class="sr-only" for="rate_change_rate"><%= t("loans.form.rate_change_rate") %></label>
  <input type="number" step="0.005" min="0" max="100"
         name="account[accountable_attributes][rate_changes][][rate]"
         value="<%= rate %>"
         autocomplete="off"
         aria-label="<%= t("loans.form.rate_change_rate") %>"
         class="form-field__input">

  <button type="button" class="text-sm text-secondary underline"
          data-action="loan-rate-changes#remove">
    <%= t("loans.form.rate_change_remove") %>
  </button>
</div>
