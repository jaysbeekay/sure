<%# locals: (account:, comparison:, period: nil) %>

<%# `comparison` is the page's Loan::ExtraRepaymentComparison, built by
    AccountsController#show on the page's one `as_of`: the same two projections the
    chart at the top of the page draws, so the cards here and the extra line
    there can never quote figures from two different "todays" (#390). %>
<% loan = account.loan %>
<% extra_amount = comparison.amount %>
<%# The period the chart is showing, carried through the form and the Clear
    link so redrawing the page keeps it. A custom range has no key and travels
    as its dates. %>
<% period_params = if period.nil?
     {}
   elsif period.key.present?
     { period: period.key }
   else
     { start_date: period.start_date.iso8601, end_date: period.end_date.iso8601 }
   end %>

<div class="space-y-4">
  <p class="text-sm text-secondary"><%= t(".intro") %></p>

  <%# `_top`, not this tab's frame: the amount redraws the chart at the top of
      the page, so the whole page re-renders with this tab open (#390). %>
  <%= form_with url: account_path(account), scope: :extra_payment, method: :get,
                data: { controller: "auto-submit-form", turbo_frame: "_top" } do |f| %>
    <%= hidden_field_tag :tab, "extra_repayments", id: nil %>
    <% period_params.each do |name, value| %>
      <%= hidden_field_tag name, value, id: nil %>
    <% end %>
    <div class="flex flex-wrap items-end gap-2">
      <div class="form-field">
        <%= f.label :amount, t(".amount_label"), class: "text-xs text-secondary" %>
        <%= f.number_field :amount, value: extra_amount, min: 0, step: "0.01",
              placeholder: t(".amount_placeholder"),
              "data-auto-submit-form-target": "auto" %>
      </div>
      <%# Auto-submit (JS) fires on change; this button is the real,
          always-working submit control for JS-disabled clients. %>
      <%= render DS::Button.new(text: t(".apply"), type: "submit", variant: "outline", size: "sm") %>
      <% if extra_amount.present? %>
        <%= link_to t(".clear"), account_path(account, tab: "extra_repayments", **period_params),
              class: "text-sm text-secondary underline", data: { turbo_frame: "_top" } %>
      <% end %>
    </div>
    <%# The projection applies rate changes already recorded on the loan and
        holds the repayment; what it cannot know is a change nobody has
        recorded yet (#54). %>
    <% if loan.variable_rate_type? %>
      <p class="text-xs text-subdued mt-1"><%= t(".variable_rate_notice") %></p>
    <% end %>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
    <% if comparison.extra_applicable? %>
      <%= summary_card title: t(".payoff_with_extra") do %>
        <span data-testid="extra-payoff-date"><%= l comparison.extra.payoff_date, format: :long %></span>
        <% if (sooner = comparison.months_sooner) %>
          <span class="block text-xs text-secondary mt-1" data-testid="extra-months-sooner"><%= t(".months_sooner", count: sooner) %></span>
        <% end %>
      <% end %>

      <% if (saved = comparison.interest_saved) %>
        <%= summary_card title: t(".interest_saved") do %>
          <span data-testid="extra-interest-saved"><%= format_money saved %></span>
        <% end %>
      <% end %>
    <% end %>

    <% if comparison.baseline.applicable? %>
      <%= summary_card title: t(".payoff_without_extra") do %>
        <span data-testid="baseline-payoff-date"><%= l comparison.baseline.payoff_date, format: :long %></span>
      <% end %>
    <% end %>
  </div>

  <% if (notice = comparison.non_convergence_notice) %>
    <p class="text-sm text-secondary"><%= t(".projection_not_converged.#{notice}") %></p>
  <% end %>
</div>
