<%# locals: (account:, as_of: Date.current) %>

<%# FR-404. Read from the in-memory schedule, not from loan.amortizations: the
    persisted rows are a cache for the API and may legitimately be absent or
    stale on a read (#39). %>
<% payoff_date = account.loan.amortization_schedule&.payoff_date %>

<%# ONE reference date for every figure on this tab, `as_of`, taken as a local
    so a caller (and a test) can pin it. It used to be declared inside the
    Monthly Payment card, which renders after the Interest Rate card, so the two
    could not share a date even in principle. A render crossing midnight on a
    rate-change date would then quote yesterday's rate beside today's
    repayment. The repayment card below answers for the same date. %>

<div class="grid grid-cols-2 gap-2 md:grid-cols-4">
  <%= summary_card title: t(".original_loan_balance") do %>
    <%= format_money account.loan.original_balance %>
  <% end %>

  <%= summary_card title: t(".remaining_principal") do %>
    <%= format_money account.balance_money %>
  <% end %>

  <%# The rate in force TODAY, not the one the loan was written at.
      `loans.interest_rate` is the origination rate; on a variable loan with any
      recorded change this card was the only surface still quoting it, while the
      caption on the card beside it and the Schedule tab's rate-change table both
      showed the current one. Three surfaces, two answers.

      `current_variable_rate` returns the column unchanged for a fixed loan, so
      those are unaffected -- and it falls back to the column when no change
      applies, which keeps the nullable case rendering "Unknown". %>
  <%= summary_card title: t(".current_interest_rate") do %>
    <% current_rate = account.loan.current_variable_rate(as_of) %>
    <% if current_rate.present? %>
      <%= number_to_percentage(current_rate, precision: 3) %>
    <% else %>
      <%= t(".unknown") %>
    <% end %>
  <% end %>

  <%# FR-204: a variable loan printed "N/A" here, because the contracted
      monthly_payment is sized from the ORIGINAL balance at the FIRST payment
      date and ignores every rate change since. current_minimum_payment is the
      contracted schedule's payment in force, re-amortised on the scheduled
      balance at each recorded rate change -- the figure a lender quotes (#392). The Schedule tab
      shows the same value from the same method, so the two cannot disagree. %>
  <%= summary_card title: t(".current_monthly_payment") do %>
    <% current_payment = account.loan.current_minimum_payment(as_of: as_of) %>
    <% if current_payment.present? %>
      <%= format_money(current_payment) %>
      <% if account.loan.rate_type != 'fixed' %>
        <%# A block-level span, not a <p>: summary_card already wraps this in a
            <p class="privacy-sensitive">, and a nested <p> makes the browser
            close that wrapper early -- which drops the rate out of Privacy
            Mode's blur as well as being invalid markup. %>
        <span class="block text-xs text-subdued mt-1">
          <%= t(".minimum_payment_rate", rate: number_to_percentage(account.loan.current_variable_rate(as_of), precision: 3, strip_insignificant_zeros: true)) %>
        </span>
      <% end %>
    <% else %>
      <%= t(".unknown") %>
    <% end %>
  <% end %>

  <%= summary_card title: t(".term") do %>
    <% if account.loan.term_months.present? %>
      <% if account.loan.term_months < 12 %>
        <%= pluralize(account.loan.term_months, "month") %>
      <% else %>
        <%= pluralize(account.loan.term_months / 12, "year") %>
      <% end %>
    <% else %>
      <%= t(".unknown") %>
    <% end %>
  <% end %>

  <%= summary_card title: t(".original_payoff_date") do %>
    <% if payoff_date.present? %>
      <%= l payoff_date, format: :long %>
    <% else %>
      <%= t(".unknown") %>
    <% end %>
  <% end %>

  <%= summary_card title: t(".type") do %>
    <% type = account.loan.rate_type&.titleize || t(".unknown") %>
    <% type = t(".variable_with_offset") if account.loan.variable_rate_type? && account.loan.countable_offset_accounts.any? %>
    <%= type %>
  <% end %>

  <%# What the loan costs in total: the Schedule tab's "Total Cost" (principal
      and interest) plus any premium charged beside it. With a premium the
      title says so, because both tabs render on one page and the same title
      over two different amounts reads as a mistake. Unknown without a schedule
      to read interest from, the same condition the payoff date answers with. %>
  <%= summary_card title: account.loan.insurance.present? ? t(".total_cost_with_insurance") : t(".total_cost") do %>
    <% total_cost = account.loan.total_cost %>
    <%= total_cost ? format_money(total_cost) : t(".unknown") %>
  <% end %>

  <%# Only for a loan carrying a premium. A card reading zero would say the
      borrower has insurance costing nothing rather than none recorded. A rate
      saved on a loan with no schedule to project it against still shows, as
      the rate, rather than vanishing as though the save had been lost. %>
  <% if account.loan.insurance.present? %>
    <%= summary_card title: t(".total_insurance") do %>
      <%= format_money(account.loan.total_insurance) %>
    <% end %>
  <% elsif account.loan.insurance_rate&.positive? %>
    <%= summary_card title: t(".total_insurance") do %>
      <%= t(".insurance_rate_only", rate: number_to_percentage(account.loan.insurance_rate, strip_insignificant_zeros: true)) %>
    <% end %>
  <% end %>

  <%# Leverage needs a down payment to be a ratio at all, and a loan with none
      recorded is not unleveraged -- it is one nobody has told us about. %>
  <% if account.loan.initial_leverage_ratio.present? %>
    <%= summary_card title: t(".leverage") do %>
      <span class="<%= loan_leverage_band_class(account.loan.leverage_band) %>">
        <%= t(".leverage_multiple", ratio: number_with_precision(account.loan.initial_leverage_ratio, precision: 1)) %>
        <span class="text-sm"><%= t(".leverage_band_#{account.loan.leverage_band}") %></span>
      </span>
    <% end %>
  <% end %>
</div>

<%= render "loans/tabs/repayment_progress", loan: account.loan, as_of: as_of %>

<%= render UI::Account::CollateralPosition.new(account: account, viewer: Current.user) %>

<div class="flex justify-center py-8">
  <%= render DS::Link.new(
    text: t(".edit_loan_details"),
    variant: "ghost",
    href: edit_loan_path(account),
    frame: :modal
  ) %>
</div>
