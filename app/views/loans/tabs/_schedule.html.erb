<%# locals: (account:) %>

<%# One `today` for the chart, the projection and the table. Read separately,
    a render crossing midnight can show a chart projecting from one date beside
    a table shaded against another. %>
<% today = Date.current %>
<% schedule = account.loan.amortization_schedule %>
<% payments = schedule.payments %>
<% chart = loan_payoff_chart(account, as_of: today) %>

<div class="space-y-4">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
    <%# A re-amortising loan has no single monthly payment, so the card says
        which one this is rather than implying the figure holds for the term. %>
    <%= summary_card title: schedule.re_amortising? ? t(".opening_payment") : t(".monthly_payment") do %>
      <%= format_money schedule.periodic_payment %>
    <% end %>

    <%= summary_card title: t(".total_interest") do %>
      <%= format_money schedule.total_interest %>
    <% end %>

    <%= summary_card title: t(".total_cost") do %>
      <%= format_money schedule.total_paid %>
    <% end %>

    <%= summary_card title: t(".payoff_date") do %>
      <%= l schedule.payoff_date, format: :long %>
    <% end %>
  </div>

  <p class="text-sm text-secondary">
    <%= t(".description", start_date: l(account.loan.origination_date, format: :long)) %>
  </p>

  <% if chart %>
    <%# privacy-sensitive: the axis, the lines and the tooltip are all balances,
        and Privacy Mode blurs balances everywhere else on this page. %>
    <div data-controller="loan-payoff-chart"
         data-loan-payoff-chart-data-value="<%= chart.to_json %>"
         class="h-64 w-full privacy-sensitive"></div>

    <ul class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-secondary">
      <li class="flex items-center gap-1.5">
        <span class="inline-block w-4 h-0 border-t-2 border-dashed" style="border-color: var(--color-red-500);" aria-hidden="true"></span>
        <%= chart[:labels][:scheduled] %>
      </li>
      <li class="flex items-center gap-1.5">
        <span class="inline-block w-4 h-0 border-t-2" style="border-color: var(--color-green-600);" aria-hidden="true"></span>
        <%= chart[:labels][:projected] %>
      </li>
    </ul>

    <%# The accessible alternative is real DOM text, not only an SVG aria-label:
        gate G6 asks for figures a screen reader can reach the same way the
        sighted summary cards above are reached. %>
    <p class="sr-only"><%= chart[:aria_description] %></p>
  <% end %>

  <% if account.loan.variable_rate_type? %>
    <p class="text-sm text-secondary"><%= t(".variable_rate_notice") %></p>
  <% end %>

  <div class="rounded-xl bg-container shadow-xs border border-alpha-black-25 overflow-hidden">
    <div class="max-h-[32rem] overflow-y-auto overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="sticky top-0 bg-container border-b border-alpha-black-25">
          <tr class="text-secondary text-left">
            <th scope="col" class="font-medium px-4 py-3"><%= t(".number") %></th>
            <th scope="col" class="font-medium px-4 py-3"><%= t(".date") %></th>
            <th scope="col" class="font-medium px-4 py-3 text-right"><%= t(".payment") %></th>
            <th scope="col" class="font-medium px-4 py-3 text-right"><%= t(".principal") %></th>
            <th scope="col" class="font-medium px-4 py-3 text-right"><%= t(".interest") %></th>
            <th scope="col" class="font-medium px-4 py-3 text-right"><%= t(".remaining_balance") %></th>
          </tr>
        </thead>
        <tbody>
          <% payments.each do |payment| %>
            <tr class="border-b border-alpha-black-25 last:border-0 <%= "bg-container-inset" if payment.date <= today %>">
              <td class="px-4 py-3 text-secondary tabular-nums"><%= payment.number %></td>
              <td class="px-4 py-3 text-primary"><%= l payment.date, format: :long %></td>
              <td class="px-4 py-3 text-right text-primary tabular-nums privacy-sensitive"><%= format_money payment.payment %></td>
              <td class="px-4 py-3 text-right text-primary tabular-nums privacy-sensitive"><%= format_money payment.principal %></td>
              <td class="px-4 py-3 text-right text-secondary tabular-nums privacy-sensitive"><%= format_money payment.interest %></td>
              <td class="px-4 py-3 text-right text-primary tabular-nums privacy-sensitive"><%= format_money payment.ending_balance %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
