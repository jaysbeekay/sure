<div class="container mx-auto max-w-6xl px-4 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2"><%= t(".title", account: @account.name) %></h1>
    <p class="text-base-content/60"><%= t(".subtitle") %></p>
  </div>

  <div class="card bg-base-100 shadow-md mb-8">
    <div class="card-body">
      <h2 class="card-title"><%= t(".summary") %></h2>

      <div class="grid grid-cols-4 gap-4">
        <div class="stat">
          <div class="stat-title"><%= t(".loan_amount") %></div>
          <div class="stat-value text-lg"><%= format_money(@loan.original_balance) %></div>
        </div>

        <div class="stat">
          <div class="stat-title"><%= t(".interest_rate") %></div>
          <div class="stat-value text-lg"><%= number_to_percentage(@loan.interest_rate, precision: 3) %></div>
        </div>

        <div class="stat">
          <div class="stat-title"><%= t(".term") %></div>
          <div class="stat-value text-lg"><%= @loan.term_months %> <%= t(".months") %></div>
        </div>

        <div class="stat">
          <div class="stat-title"><%= t(".total_interest") %></div>
          <div class="stat-value text-lg text-warning">
            <%= format_money(Money.new(@loan.amortization_schedules.sum(:interest_payment).round, @account.currency)) %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="table table-zebra w-full">
      <thead class="bg-base-200">
        <tr>
          <th><%= t(".payment_number") %></th>
          <th><%= t(".payment_date") %></th>
          <th><%= t(".rate") %></th>
          <th class="text-right"><%= t(".beginning_balance") %></th>
          <th class="text-right"><%= t(".payment") %></th>
          <th class="text-right"><%= t(".principal") %></th>
          <th class="text-right"><%= t(".interest") %></th>
          <th class="text-right"><%= t(".ending_balance") %></th>
        </tr>
      </thead>
      <tbody>
        <% @schedules.each do |entry| %>
          <tr class="hover:bg-base-300">
            <td><strong><%= entry.payment_number %></strong></td>
            <td><%= l(entry.payment_date, format: :short) %></td>
            <td><span class="badge badge-ghost"><%= number_to_percentage(entry.interest_rate, precision: 3) %></span></td>
            <td class="text-right"><%= format_money(Money.new(entry.beginning_balance.round, @account.currency)) %></td>
            <td class="text-right font-semibold"><%= format_money(Money.new(entry.payment_amount.round, @account.currency)) %></td>
            <td class="text-right text-success"><%= format_money(Money.new(entry.principal_payment.round, @account.currency)) %></td>
            <td class="text-right text-warning"><%= format_money(Money.new(entry.interest_payment.round, @account.currency)) %></td>
            <td class="text-right"><%= format_money(Money.new(entry.ending_balance.round, @account.currency)) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @schedules.respond_to?(:total_pages) %>
    <div class="flex justify-center mt-8">
      <%= paginate @schedules %>
    </div>
  <% end %>

  <div class="flex justify-center gap-2 mt-8">
    <%= link_to t(".back_to_account"), @account, class: "btn btn-ghost" %>
    <%= button_to t(".regenerate"), account_loan_amortization_schedules_path(@account), method: :post, class: "btn btn-primary" %>
  </div>
</div>
