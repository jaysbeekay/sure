<%# locals: (statement:, period:, as_of:, segments:, by:) %>

<%
  active_by = by.presence || "security"
  currency = statement.family.currency
  total = segments.sum { |segment| segment.amount.amount }
%>

<div id="portfolio-allocation" class="@container space-y-4">
  <%= render DS::SegmentedControl.new(aria_label: t("portfolios.allocation.grouping_aria_label")) do |sc| %>
    <% InvestmentStatement::ALLOCATION_GROUPINGS.each do |grouping| %>
      <% sc.with_segment(
        t("portfolios.allocation.groupings.#{grouping}"),
        active: active_by == grouping,
        href: portfolio_path(by: grouping)
      ) %>
    <% end %>
  <% end %>

  <div class="flex flex-col @2xl:flex-row gap-8 items-center">
    <div class="w-full @2xl:w-1/3 max-w-[300px] px-4">
      <div class="h-[300px] relative"
        data-controller="donut-chart"
        data-donut-chart-segments-value="<%= allocation_segments_json(segments, currency: currency) %>"
        data-donut-chart-segment-opacity-value="0.9"
        data-donut-chart-extended-hover-value="true"
        data-donut-chart-hover-extension-value="3">
        <div data-donut-chart-target="chartContainer" class="absolute inset-0 pointer-events-none"></div>

        <div data-donut-chart-target="contentContainer" class="flex justify-center items-center h-full">
          <div data-donut-chart-target="defaultContent" class="flex flex-col items-center">
            <div class="text-secondary text-sm mb-2"><%= t("portfolios.allocation.total") %></div>
            <div data-donut-chart-target="amount" class="text-3xl font-medium text-primary privacy-sensitive whitespace-nowrap">
              <%= format_money(Money.new(total, currency)) %>
            </div>
          </div>

          <% segments.each do |segment| %>
            <div id="segment_<%= segment.id %>" class="hidden">
              <div class="flex flex-col gap-2 items-center">
                <p class="text-sm text-secondary"><%= allocation_segment_name(segment, active_by) %></p>
                <p data-donut-chart-target="amount" class="text-3xl font-medium text-primary privacy-sensitive whitespace-nowrap"><%= format_money(segment.amount) %></p>
                <p class="text-sm text-secondary privacy-sensitive"><%= number_to_percentage(segment.weight, precision: 1) %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="w-full @2xl:w-2/3" data-portfolio-allocation="<%= active_by %>">
      <%= render "portfolios/allocation_table", statement: statement, segments: segments, by: active_by, parent: nil %>
    </div>
  </div>
</div>
