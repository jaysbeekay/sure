<%# locals: (statement:, period:, as_of:, segments:, by:, sort:, dir:, look_through:, look_through_available:) %>

<%
  active_by = by.presence || "security"
  currency = statement.family.currency
  total = segments.sum { |segment| segment.amount.amount }
%>

<div id="portfolio-allocation" class="@container space-y-4">
  <%= render DS::SegmentedControl.new(aria_label: t("portfolios.allocation.grouping_aria_label")) do |sc| %>
    <% InvestmentStatement::ALLOCATION_GROUPINGS.each do |grouping| %>
      <% sc.with_segment(
        t("portfolios.allocation.groupings.#{grouping}"),
        active: active_by == grouping,
        href: portfolio_path({ period: period.key, by: grouping, sort: sort, dir: dir,
                                look_through: ("1" if look_through) }.compact),
        data: { turbo_frame: "portfolio_sections" }
      ) %>
    <% end %>
  <% end %>

  <%# Only offered where it applies and where the portfolio actually holds a
      fund we have constituents for -- see SectionRegistry#look_through_available?. %>
  <% if look_through_available %>
    <div class="flex items-center justify-end gap-2">
      <%= link_to portfolio_path({ period: period.key, by: by, sort: sort, dir: dir,
                                   look_through: ("1" unless look_through) }.compact),
            class: "text-sm #{look_through ? "text-primary font-medium" : "text-secondary"} hover:text-primary",
            data: { turbo_frame: "portfolio_sections" } do %>
        <%= icon look_through ? "eye" : "eye-off", size: "xs", class: "inline" %>
        <%= t("portfolios.allocation.look_through") %>
      <% end %>
      <span class="text-xs text-secondary"><%= t("portfolios.allocation.look_through_hint") %></span>
    </div>
  <% end %>

  <div class="flex flex-col @2xl:flex-row gap-8 items-center">
    <div class="w-full @2xl:w-1/3 max-w-[300px] px-4">
      <div class="h-[300px] relative"
        data-controller="donut-chart"
        data-donut-chart-segments-value="<%= allocation_segments_json(segments, currency: currency) %>"
        data-donut-chart-segment-opacity-value="0.9"
        data-donut-chart-extended-hover-value="true"
        data-donut-chart-hover-extension-value="3">
        <div data-donut-chart-target="chartContainer" class="absolute inset-0 pointer-events-none"></div>

        <div data-donut-chart-target="contentContainer" class="flex justify-center items-center h-full">
          <div data-donut-chart-target="defaultContent" class="flex flex-col items-center">
            <div class="text-secondary text-sm mb-2"><%= t("portfolios.allocation.total") %></div>
            <div data-donut-chart-target="amount" class="text-3xl font-medium text-primary privacy-sensitive whitespace-nowrap">
              <%= format_money(Money.new(total, currency)) %>
            </div>
          </div>

          <% segments.each do |segment| %>
            <div id="segment_<%= segment.id %>" class="hidden">
              <div class="flex flex-col gap-2 items-center">
                <p class="text-sm text-secondary"><%= allocation_segment_name(segment, active_by) %></p>
                <p data-donut-chart-target="amount" class="text-3xl font-medium text-primary privacy-sensitive whitespace-nowrap"><%= format_money(segment.amount) %></p>
                <p class="text-sm text-secondary privacy-sensitive"><%= number_to_percentage(segment.weight, precision: 1) %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="w-full @2xl:w-2/3 bg-container-inset rounded-xl p-1 space-y-1 overflow-x-auto">
      <div class="px-4 py-2 flex items-center uppercase text-xs font-medium text-secondary">
        <p><%= t("portfolios.allocation.groupings.#{active_by}") %><span class="text-subdued mx-1">&middot;</span><%= segments.count %></p>
        <div class="ml-auto text-right flex items-center gap-6">
          <p class="w-24 @2xl:w-32"><%= t("portfolios.allocation.value") %></p>
          <p class="w-16"><%= t("portfolios.allocation.weight") %></p>
        </div>
      </div>
      <div class="py-1 shadow-border-xs rounded-lg bg-container font-medium text-sm divide-y divide-divider" data-portfolio-allocation="<%= active_by %>">
        <% segments.each_with_index do |segment, index| %>
          <%# Only the asset-class ladder nests. Everything else renders the same
              row without a disclosure, so a sector is not dressed up as
              something you can open. A <details> rather than a Stimulus
              controller, per the Hotwire-first convention. %>
          <% children = statement.allocation_children(active_by, segment.id) %>
          <% if children.any? %>
            <details class="group" data-portfolio-segment="<%= segment.id %>">
              <summary class="flex items-center gap-3 px-4 py-2 cursor-pointer list-none">
                <%= icon("chevron-right", size: "sm", class: "shrink-0 transition-transform group-open:rotate-90") %>
                <span class="h-3 w-3 rounded-full shrink-0" style="background-color: <%= allocation_color(index) %>"></span>
                <%# Phrasing content only: <summary> may not contain <p> or <div>,
                    and block children make the disclosure label inconsistent for
                    assistive technologies. Same flex classes on spans. %>
                <span class="text-primary truncate"><%= allocation_segment_name(segment, active_by) %></span>
                <span class="ml-auto text-right flex items-center gap-6">
                  <span class="w-24 @2xl:w-32 privacy-sensitive"><%= format_money(segment.amount) %></span>
                  <span class="w-16 text-secondary privacy-sensitive"><%= number_to_percentage(segment.weight, precision: 1) %></span>
                </span>
              </summary>
              <div class="pl-10 pr-4 pb-2 space-y-1 text-secondary">
                <% children.each do |child| %>
                  <% child_by = allocation_child_grouping(active_by) %>
                  <% grandchildren = statement.allocation_children(child_by, child.id) %>
                  <div data-portfolio-child="<%= child.id %>">
                    <div class="flex items-center gap-3 py-1">
                      <p class="truncate"><%= allocation_segment_name(child, child_by) %></p>
                      <div class="ml-auto text-right flex items-center gap-6">
                        <p class="w-24 @2xl:w-32 privacy-sensitive"><%= format_money(child.amount) %></p>
                        <p class="w-16 privacy-sensitive"><%= number_to_percentage(child.weight, precision: 1) %></p>
                      </div>
                    </div>
                    <% if grandchildren.any? %>
                      <div class="pl-4 space-y-1 text-subdued">
                        <% grandchildren.each do |position| %>
                          <div class="flex items-center gap-3 py-1" data-portfolio-grandchild="<%= position.id %>">
                            <p class="truncate"><%= position.name %></p>
                            <div class="ml-auto text-right flex items-center gap-6">
                              <p class="w-24 @2xl:w-32 privacy-sensitive"><%= format_money(position.amount) %></p>
                              <p class="w-16 privacy-sensitive"><%= number_to_percentage(position.weight, precision: 1) %></p>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </details>
          <% else %>
            <div class="flex items-center gap-3 px-4 py-2" data-portfolio-segment="<%= segment.id %>">
              <span class="h-3 w-3 rounded-full shrink-0" style="background-color: <%= allocation_color(index) %>"></span>
              <p class="text-primary truncate"><%= allocation_segment_name(segment, active_by) %></p>
              <div class="ml-auto text-right flex items-center gap-6">
                <p class="w-24 @2xl:w-32 privacy-sensitive"><%= format_money(segment.amount) %></p>
                <p class="w-16 text-secondary privacy-sensitive"><%= number_to_percentage(segment.weight, precision: 1) %></p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
