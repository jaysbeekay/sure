<%# locals: (statement:, period:, as_of:, series:) %>

<%# The portfolio's return as a line, with the effect of deposits removed.
    Rebased on 100 at the start of the period, so the shape is comparable
    against a benchmark later (#124) rather than being dominated by money
    going in: a deposit lifts the value chart above and leaves this one flat.

    The numbers are index LEVELS, not money. 121.34 means the portfolio
    returned 21.34% over the period. That is why this sits beside the value
    chart rather than replacing it -- the two answer different questions. %>
<div id="portfolio-index-chart">
  <div class="space-y-2 px-4">
    <p class="text-sm text-secondary"><%= t("portfolios.index_chart.explainer") %></p>
  </div>

  <div
    id="portfolioIndexChart"
    class="w-full h-52 privacy-sensitive"
    data-controller="time-series-chart"
    data-time-series-chart-data-value="<%= series.to_json %>"></div>
</div>
