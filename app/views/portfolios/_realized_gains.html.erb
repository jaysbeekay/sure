<%# locals: (statement:, period:, as_of:, realized:, bars:) %>

<%# What the portfolio actually banked over the period, by the month it banked
    it. `realized` is a Portfolio::RealizedGains; `bars` is the chart payload
    the registry built, so this partial only formats. Gains and losses are both
    positive magnitudes on the bucket -- `net` is the only signed figure. %>
<div id="portfolio-realized-gains" class="space-y-4">
  <%# Nothing disposed of and nothing excluded: say so and stop. A zero total
      and an empty chart would both be true and neither would be informative. %>
  <% unless realized.any? %>
    <div class="px-4">
      <p class="text-sm text-secondary"><%= t("portfolios.realized_gains.no_disposals", period: period.label) %></p>
    </div>
  <% end %>

  <% if realized.any? %>
  <div class="space-y-2 px-4">
    <p class="text-3xl font-medium tabular-nums privacy-sensitive <%= realized.net.negative? ? "text-destructive" : "text-primary" %>">
      <%= format_money(Money.new(realized.net, statement.family.currency)) %>
    </p>
    <p class="text-xs text-secondary">
      <%= t("portfolios.realized_gains.summary", count: realized.trade_count, period: period.label) %>
    </p>
  </div>

  <%# The section also renders when every disposal was excluded, which leaves no
      bars. The chart controller bails on empty data, so without this the page
      would carry a blank 11rem box above the warning that is the only thing
      there is to say. %>
  <% if bars.any? %>
    <div class="px-4 flex items-center gap-4">
      <span class="flex items-center gap-1.5 text-xs text-secondary">
        <span class="w-2 h-2 rounded-full bg-success"></span>
        <%= t("portfolios.realized_gains.gains") %>
      </span>
      <span class="flex items-center gap-1.5 text-xs text-secondary">
        <span class="w-2 h-2 rounded-full bg-subdued"></span>
        <%= t("portfolios.realized_gains.losses") %>
      </span>
    </div>

    <div class="w-full h-44 privacy-sensitive"
      data-controller="bar-chart"
      data-bar-chart-data-value="<%= bars.to_json %>"
      data-bar-chart-currency-value="<%= statement.family.currency %>"
      data-bar-chart-income-label-value="<%= t("portfolios.realized_gains.gains") %>"
      data-bar-chart-expense-label-value="<%= t("portfolios.realized_gains.losses") %>">
    </div>
  <% end %>

  <% end %>

  <%# A disposal this page could not measure is named rather than folded into
      the total as a zero, so a figure that leaves trades out says so where the
      figure is, not only in the object behind it. %>
  <% if realized.excluded_trades.any? %>
    <div class="px-4">
      <%= render DS::Alert.new(title: t("portfolios.realized_gains.excluded_title"), variant: :warning) do %>
        <ul class="text-xs text-secondary space-y-1">
          <% realized.excluded_trades.each do |reason, count| %>
            <li><%= t("portfolios.realized_gains.excluded.#{reason}", count: count) %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% end %>
</div>
