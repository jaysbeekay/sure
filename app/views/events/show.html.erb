<div class="@container space-y-6 pb-6 lg:pb-12">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex items-start gap-3">
      <span class="size-3 rounded-full shrink-0 mt-2.5" style="background-color: <%= @event.color %>;" aria-hidden="true"></span>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl font-semibold text-primary"><%= @event.name %></h1>
          <%= render DS::Pill.new(label: t("shared.preview"), size: :md) %>
        </div>
        <p class="text-sm text-secondary mt-1">
          <%= t("events.date_range", start: l(@event.start_date, format: :long), end: l(@event.end_date, format: :long)) %>
          <span class="text-subdued mx-1">&middot;</span>
          <%= t("events.days", count: @event.days) %>
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <%= render DS::Link.new(text: t(".edit"), variant: "outline", icon: "pencil", href: edit_event_path(@event)) %>
      <%= render DS::Button.new(
            text: t(".delete"),
            variant: "outline_destructive",
            icon: "trash-2",
            href: event_path(@event),
            method: :delete,
            confirm: CustomConfirm.for_resource_deletion(@event.name)) %>
    </div>
  </header>

  <section class="grid grid-cols-1 @2xl:grid-cols-3 gap-3">
    <%= render DS::Card.new do %>
      <p class="text-xs font-medium uppercase tracking-wide text-secondary"><%= t(".kpi.true_cost") %></p>
      <p class="text-3xl font-medium text-primary tabular-nums mt-2 privacy-sensitive" data-testid="event-true-cost"><%= @true_cost.format %></p>
      <p class="text-xs text-secondary mt-1"><%= t(".kpi.true_cost_hint") %></p>
    <% end %>

    <%= render DS::Card.new do %>
      <p class="text-xs font-medium uppercase tracking-wide text-secondary"><%= t(".kpi.transactions") %></p>
      <p class="text-3xl font-medium text-primary tabular-nums mt-2"><%= @transaction_count %></p>
    <% end %>

    <%= render DS::Card.new do %>
      <p class="text-xs font-medium uppercase tracking-wide text-secondary"><%= t(".kpi.per_day") %></p>
      <p class="text-3xl font-medium text-primary tabular-nums mt-2 privacy-sensitive"><%= (@true_cost / @event.days).format %></p>
    <% end %>
  </section>

  <%= render DS::Card.new do %>
    <h2 class="text-base font-medium text-primary"><%= t(".chart.title") %></h2>
    <p class="text-sm text-secondary mb-4"><%= t(".chart.hint") %></p>

    <% if @cumulative_series %>
      <div class="w-full h-52 privacy-sensitive"
           data-controller="time-series-chart"
           data-time-series-chart-data-value="<%= @cumulative_series.to_json %>"
           draggable="false"></div>
    <% else %>
      <p class="text-sm text-secondary"><%= t(".chart.too_short") %></p>
    <% end %>
  <% end %>

  <%= render DS::Card.new do %>
    <h2 class="text-base font-medium text-primary"><%= t(".categories.title") %></h2>
    <p class="text-sm text-secondary mb-4"><%= t(".categories.hint") %></p>

    <% if @category_breakdown.any? %>
      <div class="flex flex-col @2xl:flex-row gap-8 items-center">
        <div class="w-full @2xl:w-1/3 max-w-[300px] px-4">
          <div class="h-[300px] relative"
               data-controller="donut-chart"
               data-donut-chart-segments-value="<%= event_donut_segments_json(@category_breakdown) %>"
               data-donut-chart-segment-opacity-value="0.9"
               data-donut-chart-extended-hover-value="true"
               data-donut-chart-hover-extension-value="3">
            <div data-donut-chart-target="chartContainer" class="absolute inset-0 pointer-events-none"></div>

            <div data-donut-chart-target="contentContainer" class="flex justify-center items-center h-full">
              <div data-donut-chart-target="defaultContent" class="flex flex-col items-center">
                <div class="text-secondary text-sm mb-2"><%= t(".categories.total") %></div>
                <div data-donut-chart-target="amount" class="text-3xl font-medium text-primary privacy-sensitive whitespace-nowrap">
                  <%= Money.new(@category_breakdown.sum { |row| row.total.amount }, @true_cost.currency).format %>
                </div>
              </div>

              <% @category_breakdown.each do |row| %>
                <div id="segment_<%= event_segment_id(row.category) %>" class="hidden">
                  <div class="flex flex-col gap-2 items-center">
                    <p class="text-sm text-secondary"><%= row.category.name %></p>
                    <p data-donut-chart-target="amount" class="text-3xl font-medium text-primary privacy-sensitive whitespace-nowrap"><%= row.total.format %></p>
                    <p class="text-sm text-secondary privacy-sensitive"><%= number_to_percentage(row.weight, precision: 1) %></p>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <div class="w-full @2xl:w-2/3">
          <%= render DS::Table.new(rows: @category_breakdown, inset: true, label: t(".categories.title")) do |table| %>
            <% table.with_column(t("events.show.transactions.category")) do |row| %>
              <span class="flex items-center gap-2">
                <span class="size-2 rounded-full shrink-0" style="background-color: <%= row.category.color %>;" aria-hidden="true"></span>
                <%= row.category.name %>
              </span>
            <% end %>
            <% table.with_column(t(".categories.amount"), numeric: true, class: "privacy-sensitive") { |row| row.total.format } %>
            <% table.with_column(t(".categories.weight"), numeric: true) { |row| number_to_percentage(row.weight, precision: 1) } %>
          <% end %>
        </div>
      </div>
    <% else %>
      <p class="text-sm text-secondary"><%= t(".categories.empty") %></p>
    <% end %>
  <% end %>

  <%= render DS::Card.new do %>
    <div class="flex flex-wrap items-start justify-between gap-2 mb-4">
      <div>
        <h2 class="text-base font-medium text-primary"><%= t(".transactions.title") %></h2>
        <p class="text-sm text-secondary"><%= t(".transactions.hint") %></p>
      </div>
      <%= render DS::Link.new(
            text: t(".transactions.see_all"),
            variant: "default",
            href: transactions_path(q: { start_date: @event.start_date, end_date: @event.end_date })) %>
    </div>

    <% if @transactions.any? %>
      <%= render DS::Table.new(rows: @transactions, inset: true, label: t(".transactions.table_label")) do |table| %>
        <% table.with_column(t(".transactions.date")) { |transaction| l(transaction.entry.date, format: :short) } %>
        <% table.with_column(t(".transactions.name")) do |transaction| %>
          <%= link_to transaction.entry.name, entry_path(transaction.entry), class: "text-primary hover:underline", data: { turbo_frame: "_top" } %>
          <% if @manually_included_ids.include?(transaction.id) %>
            <%= render DS::Pill.new(label: t(".transactions.manual"), tone: :gray) %>
          <% end %>
        <% end %>
        <% table.with_column(t(".transactions.category")) { |transaction| transaction.category&.name || t(".transactions.uncategorized") } %>
        <% table.with_column(t(".transactions.account")) { |transaction| transaction.entry.account.name } %>
        <% table.with_column(t(".transactions.amount"), numeric: true, class: "privacy-sensitive") { |transaction| transaction.entry.amount_money.format } %>
        <% table.with_column("", align: :right) do |transaction| %>
          <% if @manually_included_ids.include?(transaction.id) %>
            <%= render DS::Button.new(
                  text: t(".transactions.remove_manual"),
                  variant: "ghost",
                  size: "sm",
                  href: reset_transaction_event_path(@event),
                  method: :delete,
                  params: { transaction_id: transaction.id }) %>
          <% else %>
            <%= render DS::Button.new(
                  text: t(".transactions.remove"),
                  variant: "ghost",
                  size: "sm",
                  href: exclude_transaction_event_path(@event),
                  method: :post,
                  params: { transaction_id: transaction.id }) %>
          <% end %>
        <% end %>
      <% end %>

      <% if @transaction_count > @transactions.size %>
        <p class="text-xs text-secondary mt-2"><%= t(".transactions.truncated", shown: @transactions.size, total: @transaction_count) %></p>
      <% end %>
    <% else %>
      <p class="text-sm text-secondary"><%= t(".transactions.empty") %></p>
    <% end %>
  <% end %>

  <% if @removed.any? %>
    <%= render DS::Card.new do %>
      <h2 class="text-base font-medium text-primary"><%= t(".removed.title") %></h2>
      <p class="text-sm text-secondary mb-4"><%= t(".removed.hint") %></p>

      <%= render DS::Table.new(rows: @removed, inset: true, label: t(".removed.table_label")) do |table| %>
        <% table.with_column(t(".transactions.date")) { |transaction| l(transaction.entry.date, format: :short) } %>
        <% table.with_column(t(".transactions.name")) { |transaction| transaction.entry.name } %>
        <% table.with_column(t(".transactions.amount"), numeric: true, class: "privacy-sensitive") { |transaction| transaction.entry.amount_money.format } %>
        <% table.with_column("", align: :right) do |transaction| %>
          <%= render DS::Button.new(
                text: t(".removed.restore"),
                variant: "ghost",
                size: "sm",
                href: reset_transaction_event_path(@event),
                method: :delete,
                params: { transaction_id: transaction.id }) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render DS::Card.new do %>
    <h2 class="text-base font-medium text-primary"><%= t(".nearby.title") %></h2>
    <p class="text-sm text-secondary mb-4"><%= t(".nearby.hint", days: @nearby_window) %></p>

    <% if @nearby.any? %>
      <%= styled_form_with url: include_transaction_event_path(@event), method: :post, class: "flex flex-wrap items-end gap-3" do |f| %>
        <div class="flex-1 min-w-48">
          <%= f.select :transaction_id,
                       @nearby.map { |transaction| [ t(".nearby.option", date: l(transaction.entry.date, format: :short), name: transaction.entry.name, amount: transaction.entry.amount_money.format), transaction.id ] },
                       { label: t(".nearby.label"), prompt: t(".nearby.prompt") },
                       { required: true } %>
        </div>
        <%= render DS::Button.new(text: t(".nearby.submit"), type: :submit, variant: "primary") %>
      <% end %>
    <% else %>
      <p class="text-sm text-secondary"><%= t(".nearby.empty") %></p>
    <% end %>
  <% end %>
</div>
