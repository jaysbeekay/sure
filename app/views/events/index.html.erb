<div class="space-y-6 pb-6 lg:pb-12">
  <header class="flex items-start justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl font-semibold text-primary"><%= t(".title") %></h1>
        <%= render DS::Pill.new(label: t("shared.preview"), size: :md) %>
      </div>
      <p class="text-sm text-secondary mt-1"><%= t(".subtitle") %></p>
    </div>

    <%= render DS::Link.new(text: t(".new_event"), variant: "primary", icon: "plus", href: new_event_path) %>
  </header>

  <% if @events.any? %>
    <%= render DS::Table.new(rows: @events, label: t(".table_label")) do |table| %>
      <% table.with_column(t(".name")) do |event| %>
        <%= link_to event_path(event), class: "flex items-center gap-2 font-medium text-primary hover:underline" do %>
          <span class="size-2 rounded-full shrink-0" style="background-color: <%= event.color %>;" aria-hidden="true"></span>
          <%= event.name %>
        <% end %>
      <% end %>
      <% table.with_column(t(".dates")) { |event| t("events.date_range", start: l(event.start_date, format: :long), end: l(event.end_date, format: :long)) } %>
      <% table.with_column(t(".length"), numeric: true) { |event| t("events.days", count: event.days) } %>
    <% end %>
  <% else %>
    <%= render DS::Card.new do %>
      <%= render DS::EmptyState.new(icon: "calendar-range", title: t(".empty_title"), description: t(".empty_description")) do |empty| %>
        <% empty.with_action do %>
          <%= render DS::Link.new(text: t(".new_event"), variant: "primary", icon: "plus", href: new_event_path) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
