<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h3 class="text-lg font-semibold"><%= t(".title") %></h3>
    <% if can_generate? && !has_schedule? %>
      <%= button_to account_loan_amortization_schedules_path(loan.account), method: :post, class: "btn btn-sm btn-primary" do %>
        <%= helpers.icon("refresh-cw", size: "sm") %>
        <%= t(".generate") %>
      <% end %>
    <% elsif has_schedule? %>
      <%= button_to account_loan_amortization_schedules_path(loan.account), method: :post, class: "btn btn-sm btn-ghost" do %>
        <%= helpers.icon("refresh-cw", size: "sm") %>
        <%= t(".regenerate") %>
      <% end %>
    <% end %>
  </div>

  <% if !has_schedule? %>
    <div class="alert alert-info">
      <div class="flex gap-2">
        <%= helpers.icon("info", size: "md") %>
        <span><%= t(".no_schedule") %></span>
      </div>
    </div>
  <% else %>
    <% if schedule_summary %>
      <div class="grid grid-cols-3 gap-2">
        <div class="rounded-xl bg-container shadow-xs border border-alpha-black-25 p-4">
          <h4 class="text-secondary text-sm"><%= t(".total_payments") %></h4>
          <p class="text-xl font-medium text-primary privacy-sensitive"><%= schedule_summary[:total_payments] %></p>
        </div>

        <div class="rounded-xl bg-container shadow-xs border border-alpha-black-25 p-4">
          <h4 class="text-secondary text-sm"><%= t(".total_principal") %></h4>
          <p class="text-xl font-medium text-primary privacy-sensitive"><%= schedule_summary[:total_principal].format %></p>
        </div>

        <div class="rounded-xl bg-container shadow-xs border border-alpha-black-25 p-4">
          <h4 class="text-secondary text-sm"><%= t(".total_interest") %></h4>
          <p class="text-xl font-medium text-primary privacy-sensitive"><%= schedule_summary[:total_interest].format %></p>
        </div>
      </div>
    <% end %>

    <div class="overflow-x-auto">
      <table class="table table-sm">
        <thead>
          <tr>
            <th><%= t(".payment_number") %></th>
            <th><%= t(".payment_date") %></th>
            <th><%= t(".rate") %></th>
            <th class="text-right"><%= t(".beginning_balance") %></th>
            <th class="text-right"><%= t(".payment") %></th>
            <th class="text-right"><%= t(".principal") %></th>
            <th class="text-right"><%= t(".interest") %></th>
            <th class="text-right"><%= t(".ending_balance") %></th>
          </tr>
        </thead>
        <tbody>
          <% schedule_entries.each do |entry| %>
            <tr class="hover:bg-base-200">
              <td><strong><%= entry.payment_number %></strong></td>
              <td><%= l(entry.payment_date, format: :short) %></td>
              <td><%= helpers.number_to_percentage(entry.interest_rate, precision: 3) %></td>
              <td class="text-right"><%= Money.new(entry.beginning_balance.round, loan.account.currency).format %></td>
              <td class="text-right font-semibold"><%= Money.new(entry.payment_amount.round, loan.account.currency).format %></td>
              <td class="text-right text-success"><%= Money.new(entry.principal_payment.round, loan.account.currency).format %></td>
              <td class="text-right text-warning"><%= Money.new(entry.interest_payment.round, loan.account.currency).format %></td>
              <td class="text-right"><%= Money.new(entry.ending_balance.round, loan.account.currency).format %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if !showing_all? %>
      <div class="text-center py-4">
        <p class="text-sm text-base-content/60 mb-2">
          <%= t(".showing_first_payments", count: schedule_entries.count, total: total_entries) %>
        </p>
        <%= link_to t(".view_all"), account_loan_amortization_schedules_path(loan.account), class: "link link-primary" %>
      </div>
    <% end %>
  <% end %>
</div>
